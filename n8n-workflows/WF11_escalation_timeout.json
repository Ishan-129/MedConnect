    {
      "parameters": {
        "jsCode": "const itemsList = typeof $input !== 'undefined' ? $input.all() : (typeof items !== 'undefined' ? items : []);\nif (!itemsList || itemsList.length === 0 || !itemsList[0].json || !itemsList[0].json.id) {\n  return [];\n}\n\nconst timeoutSec = 180;\nconst TWILIO_TO_NUMBER = '+919354543523';\nconst TWILIO_FROM_NUMBER = '+17372212163';\nconst ESCALATED_RADIUS_KM = 15;\n\nreturn itemsList.map(item => {\n  const data = item.json;\n  const requestId = data.request_id || data.id || 'REQ-UNKNOWN';\n  const hospitalName = (data.hospitals && data.hospitals.name) || data.requesting_hospital_name || data.hospital_name || 'Hospital Facility';\n  const resourceType = data.resource_type || 'Critical Resources';\n  const quantity = data.quantity || 1;\n  const originalRadius = Number(data.radius_km) || 10;\n  \n  const twiml = `<Response><Say voice=\"alice\">Emergency Escalation Alert from MedConnect Pulse. Hospital ${hospitalName} has an unfulfilled critical request for ${quantity} units of ${resourceType}. The 3 minute response window has timed out. Immediate regional coordinator intervention required.</Say></Response>`;\n\n  return {\n    json: {\n      ...data,\n      request_id: requestId,\n      original_radius_km: originalRadius,\n      radius_km: ESCALATED_RADIUS_KM,\n      radius_expanded: true,\n      status: 'ESCALATED',\n      escalated_at: new Date().toISOString(),\n      twilio_to: TWILIO_TO_NUMBER,\n      twilio_from: TWILIO_FROM_NUMBER,\n      twilio_twiml: twiml,\n      alert_message: `Emergency Escalation: Hospital ${hospitalName} needs ${quantity} ${resourceType}. Radius expanded to 15km.`,\n      exception_details: {\n        workflow: 'WF11_ESCALATION_TIMEOUT',\n        record_id: requestId,\n        error_type: 'TIMEOUT_UNACCEPTED',\n        severity: 'CRITICAL',\n        owner: 'REGIONAL_COORDINATOR'\n      }\n    }\n  };\n});"
      },
