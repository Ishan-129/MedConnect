# ==========================================
# MedConnect Pulse — Environment Variables
# ==========================================

# 1. Supabase (Application Database & Realtime)
# Used by frontend and backend migrations
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Sarvam AI (Speech-to-Text / Indic Voice Layer)
# Model: saaras:v1 | Supported: hi-IN, en-IN, te-IN, ta-IN
SARVAM_API_KEY=your_sarvam_api_key_here

# 3. OpenAI (Administrative Intent Agent)
# Model: gpt-4o-mini (Pinned per spec section 0.1)
OPENAI_API_KEY=your_openai_api_key_here

# 4. Telegram Alerts (Hospital Emergency Managers & Receptionists)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALERT_CHAT_ID=your_telegram_group_or_channel_id

# 5. Twilio (Emergency Voice Escalation Fallback)
# Triggers if no hospital accepts within EMERGENCY_RESPONSE_TIMEOUT_SEC (180s)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_ESCALATION_TO_NUMBER=+919876543210

# 6. Cryptographic Security & Anti-Tamper
# Used for HMAC-SHA256 signing of Appointment & Emergency Dispatch QRs
QR_SIGNING_SECRET=generate_a_secure_64_character_random_hex_string

# 7. n8n Automation Engine Webhooks
N8N_WEBHOOK_BASE_URL=https://your-n8n-instance.app/webhook
# If testing locally with Cloudflare Tunnel or ngrok:
# N8N_WEBHOOK_BASE_URL=https://n8n-tunnel.domain.com/webhook

# 8. Operational Thresholds & Defaults (§0.3 of Spec)
EMERGENCY_RADIUS_KM=10
EMERGENCY_RESPONSE_TIMEOUT_SEC=180
SLOT_HOLD_TIMEOUT_SEC=120
DISPATCH_QR_TTL_MIN=60
APPOINTMENT_QR_GRACE_MIN=30
