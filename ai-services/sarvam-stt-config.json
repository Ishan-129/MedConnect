{
  "service": "Sarvam AI Speech Services",
  "stt": {
    "module": "Saaras / Saarika Multilingual Speech-to-Text",
    "endpoint": "https://api.sarvam.ai/speech-to-text",
    "model": "saaras:v1",
    "alternative_model": "saarika:v2.5",
    "description": "Production configuration for Sarvam AI Saaras/Saarika STT used in MedConnect Pulse voice intake pipeline.",
    "audio_specifications": {
      "supported_formats": ["audio/webm", "audio/wav", "audio/mp3", "audio/ogg", "audio/flac"],
      "preferred_format": "audio/webm",
      "encoding": "multipart/form-data or base64",
      "sample_rate_hz": 16000,
      "min_sample_rate_hz": 8000,
      "max_sample_rate_hz": 48000,
      "channels": 1,
      "channel_layout": "mono",
      "max_duration_seconds": 60,
      "chunk_size_ms": 250
    },
    "domain_prompt_biasing": "Dr. Rajesh Sharma, Dr. Priya Ananth, Dr. Amit Patel, Dr. Vikram Malhotra, Dr. Sunita Rao, Dr. Ananya Roy, Cardiology, Orthopedics, Neurology, General Medicine, Pediatrics, Dermatology, OPD, appointment, token MED-101, token MED-102, ICU bed, ventilator, emergency",
    "language_configuration": {
      "default_language_code": "hi-IN",
      "supported_languages": [
        { "name": "Hindi", "code": "hi-IN" },
        { "name": "English", "code": "en-IN" },
        { "name": "Tamil", "code": "ta-IN" },
        { "name": "Telugu", "code": "te-IN" },
        { "name": "Bengali", "code": "bn-IN" },
        { "name": "Marathi", "code": "mr-IN" },
        { "name": "Gujarati", "code": "gu-IN" },
        { "name": "Kannada", "code": "kn-IN" },
        { "name": "Punjabi", "code": "pa-IN" },
        { "name": "Odia", "code": "or-IN" }
      ]
    },
    "http_headers": {
      "api-subscription-key": "ENV:SARVAM_API_KEY"
    },
    "resilience_policy": {
      "request_timeout_ms": 10000,
      "max_retries": 3,
      "retry_backoff_ms": 1500,
      "retryable_status_codes": [429, 500, 502, 503, 504],
      "fallback_behavior": {
        "on_failure": "SWITCH_TO_TEXT_INPUT",
        "notification_message": "Voice intake temporarily unavailable. Please use text typing."
      }
    }
  },
  "tts": {
    "module": "Bulbul Multilingual Text-to-Speech",
    "endpoint": "https://api.sarvam.ai/text-to-speech",
    "model": "bulbul:v3",
    "supported_speakers": ["priya", "aditya", "neha", "rahul", "pooja", "rohan", "anand", "kavitha"],
    "default_speaker": "priya"
  }
}
