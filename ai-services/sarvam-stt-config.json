{
  "service": "Sarvam AI Speech Services",
  "module": "Saaras Multilingual Speech-to-Text",
  "endpoint": "https://api.sarvam.ai/speech-to-text",
  "model": "saaras:v1",
  "fallback_model": "saaras:v2",
  "description": "Production configuration for Sarvam AI Saaras STT used in MedConnect Pulse voice intake pipeline.",
  "audio_specifications": {
    "supported_formats": ["audio/webm", "audio/wav", "audio/mp3", "audio/ogg", "audio/flac"],
    "preferred_format": "audio/webm",
    "encoding": "base64",
    "sample_rate_hz": 16000,
    "min_sample_rate_hz": 8000,
    "max_sample_rate_hz": 48000,
    "channels": 1,
    "channel_layout": "mono",
    "max_duration_seconds": 60,
    "chunk_size_ms": 250
  },
  "language_configuration": {
    "default_language_code": "auto",
    "supported_languages": [
      {
        "code": "hi-IN",
        "name": "Hindi",
        "native_name": "हिन्दी",
        "sarvam_code": "hi"
      },
      {
        "code": "en-IN",
        "name": "English (India)",
        "native_name": "Indian English",
        "sarvam_code": "en-IN"
      },
      {
        "code": "ta-IN",
        "name": "Tamil",
        "native_name": "தமிழ்",
        "sarvam_code": "ta"
      },
      {
        "code": "te-IN",
        "name": "Telugu",
        "native_name": "తెలుగు",
        "sarvam_code": "te"
      }
    ]
  },
  "http_headers": {
    "Content-Type": "application/json",
    "api-subscription-key": "ENV:SARVAM_API_KEY",
    "Authorization": "Bearer ENV:SARVAM_API_KEY"
  },
  "request_payload_template": {
    "model": "saaras:v1",
    "audio": "{{base64_audio_payload}}",
    "language_code": "{{language_code_or_auto}}",
    "with_timestamps": false
  },
  "resilience_policy": {
    "request_timeout_ms": 10000,
    "max_retries": 3,
    "retry_backoff_ms": 1500,
    "retryable_status_codes": [429, 500, 502, 503, 504],
    "fallback_behavior": {
      "on_failure": "SWITCH_TO_TEXT_INPUT",
      "notification_message": "Voice intake temporarily unavailable. Please use text typing."
    }
  }
}
